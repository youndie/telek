{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Everything this file used to spell out now lives in sborka and is extended by name. It was not
  // wrong — it was written ten times. The timezone, the Monday schedule, the limits, the
  // kotlin/kotlinx/sborka/ci-actions groups and "majors get a human" were identical in ten
  // repositories, which is nine copies that could drift and one that would be noticed.
  //
  // Nothing was telek-specific, so nothing stayed. If something here later needs a rule of its own,
  // it goes below the extends and wins: package rules are concatenated, preset first, and the last
  // match takes effect.
  //
  // The second preset is the automerge one, and it is extended second on purpose — its rule has to
  // land after the base preset's "majors get a human" to override it for the harness. Its
  // precondition holds here: build.yaml runs on `pull_request`, so a pull request really is
  // reviewed by a build before it merges itself.
  //
  // What telek gains that it did not have: the refusal of `kotlinx-datetime:*-0.6.x-compat`, which
  // is 0.8.0 built against the OLD 0.6.x API and which Renovate reads as an upgrade.
  extends: [
    "github>youndie/sborka",
    "github>youndie/sborka:automerge-harness",
  ],

  packageRules: [
    // RETROFIT IS NOT OURS TO UPGRADE. telek names no retrofit type anywhere -- `:telegram` declares
    // the dependency only because kotlin-telegram-bot needs it at runtime, and that library's own
    // POM (10.0.0) pins `com.squareup.retrofit2:retrofit:2.12.0`. Raising it here makes Gradle
    // resolve the higher version and run somebody else's library against a major it was not built
    // against.
    //
    // Nothing in this build would notice. The dependency is `implementation` and unused in source,
    // so no compilation fails, and telek has no test that exercises kotlin-telegram-bot at runtime
    // -- a green check on such a bump measures nothing. Renovate proposed v3 and it was green.
    //
    // So the version follows kotlin-telegram-bot, by hand, when kotlin-telegram-bot moves. If that
    // ever stops being true, the fix is to delete this rule, not to edit the number under it.
    {
      matchPackageNames: ["com.squareup.retrofit2:retrofit"],
      enabled: false,
    },
  ],
}
